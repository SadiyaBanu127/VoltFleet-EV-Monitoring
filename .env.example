# Copy to .env to customize local/Docker settings. Do not commit credentials.
DATABASE_URL=sqlite:///./ev_fleet.db
CORS_ORIGINS=http://localhost:5173
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=4
LOW_BATTERY_THRESHOLD=20
HIGH_TEMPERATURE_THRESHOLD=50
OVERSPEED_THRESHOLD=80
OFFLINE_AFTER_SECONDS=30
POSTGRES_PASSWORD=replace-with-a-local-secret
VITE_API_URL=http://localhost:8000
